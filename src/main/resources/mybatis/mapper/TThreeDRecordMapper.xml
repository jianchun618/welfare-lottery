<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fmbank.welfarelottery.mapper.TThreeDRecordMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.fmbank.welfarelottery.entity.TThreeDRecord">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="date" property="date"/>
        <result column="week" property="week"/>
        <result column="lottery_number" property="lotteryNumber"/>
        <result column="create_time" property="createTime"/>
        <result column="modify_time" property="modifyTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, code, date, week, lottery_number, create_time, modify_time
    </sql>

    <insert id="insertBatchs" parameterType="java.util.List">
        insert into t_three_d_record
        ( code, `date`, week, lottery_number,create_time,modify_time)
        values
        <foreach collection="records" item="record" index="index" separator=",">
            (
            #{record.code},
            #{record.date},
            #{record.week},
            #{record.lotteryNumber},
            #{record.createTime},
            #{record.modifyTime}
            )
        </foreach>
        on duplicate key update
        `date`=values(`date`),
        code=values(code),
        week =values(week),
        modify_time =values(modify_time)
    </insert>

    <select id="selectByYear" resultType="com.fmbank.welfarelottery.entity.TThreeDRecord">
      select * from t_three_d_record  where `date` like  REPLACE(CONCAT(#{year},'%'), '_', '\\_') order by `date`
    </select>
    <select id="selectDateByBeforeCode" resultType="com.fmbank.welfarelottery.entity.TThreeDRecord">
      select * from t_three_d_record  where code   &lt; #{code} and lottery_number= #{lotteryNumber} limit 1
    </select>
    <select id="selectByDate" resultType="com.fmbank.welfarelottery.entity.TThreeDRecord">
      select * from t_three_d_record  where `date`= #{date}  limit 1
    </select>
</mapper>
